# ══════════════════════════════════════════════════════
# APEX Trading Bot — .gitignore
# ══════════════════════════════════════════════════════

# ── Python ────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
.installed.cfg

# ── Virtual Environment ──────────────────────────────
.venv/
venv/
env/
ENV/

# ── IDE & Editor ─────────────────────────────────────
.kiro/
.claude/
.vscode/
.idea/
*.swp
*.swo
*~

# ── Logs ─────────────────────────────────────────────
*.log
*.log.*
logs/

# ── Databases & Data ─────────────────────────────────
*.db
*.duckdb
*.duckdb.wal
*.csv
data/
trade_history/
backtest_results/
training_data/

# ── ML Models & Artifacts (large binaries) ───────────
models/
lora_output/
*.gguf
*.safetensors
*.pt
*.pth
*.bin
*.h5
*.hdf5
*.onnx
*.pkl
*.joblib

# ── Secrets & Keys ───────────────────────────────────
.env
.env.*
*.key
*.pem
*.p12
*.pfx
config_local.py
bot_config.json
config_backups/

# ── OS ───────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Build Artifacts ──────────────────────────────────
build/
dist/
*.spec
*.exe
*.ex5
*.mq5

# ── Cache & Test Artifacts ───────────────────────────
.hypothesis/
.pytest_cache/
.coverage
htmlcov/
.tox/
cachedir/

# ── Node / Frontend ─────────────────────────────────
node_modules/
frontend/dashboard/dist/
frontend/dashboard/.vite/

# ── Backup & Archive ────────────────────────────────
*.backup
*.backup.*
*_backup_*
archive/
Bugs/
old/
deprecated/
static/

# ── Temporary Scripts ────────────────────────────────
*.bat
*.xml
*.xml.*

# ── ALL root-level markdown (maintenance docs) ──────
# Block every *.md in root EXCEPT README.md and QUICK_START.md
/*.md
!README.md
!QUICK_START.md

# ── ALL root-level .txt files ────────────────────────
/*.txt

# ── ALL root-level .ps1 scripts ─────────────────────
# Keep only start-apex.ps1 and stop-apex.ps1
/*.ps1
!start-apex.ps1
!stop-apex.ps1

# ── Temporary Python scripts (root level) ───────────
/test_*.py
/apply_*.py
/audit_*.py
/cleanup_*.py
/debug_*.py
/diagnose_*.py
/emergency_*.py
/enable_*.py
/explore_*.py
/find_*.py
/force_*.py
/implement_*.py
/monitor_*.py
/prepare_*.py
/reset_*.py
/restore_*.py
/show_*.py
/simple_*.py
/sync_*.py
/update_*.py
/validate_*.py
/verify_*.py
/watch_*.py
/mock_*.py
/build_exe.py

# ── Whitelist: Keep these in subdirectories ──────────
!docs/**
!workflows/**
!ml/*.md
!apex_bot/*.md
!apex_bot/APEX_SOP.md
!frontend/dashboard/README.md
!tests/README.md
!tests/test_*.py
!tests/**
!requirements*.txt
!LICENSE
