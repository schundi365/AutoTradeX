# ═══════════════════════════════════════════════════════
#  APEX TRADING BOT — Environment Configuration
#  Copy to .env and fill in your values. NEVER commit .env
# ═══════════════════════════════════════════════════════

# ── APP ─────────────────────────────────────────────────
APP_ENV=development              # development | paper | live
APP_SECRET_KEY=change_me_to_random_string
LOG_LEVEL=INFO
BOT_CYCLE_MINUTES=1              # Decision cycle interval (1-60 minutes, default: 1)

# ── MT5 BROKER ──────────────────────────────────────────
MT5_LOGIN=12345678
MT5_PASSWORD=your_mt5_password
MT5_SERVER=MetaQuotes-Demo
MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe

# ── CRYPTO EXCHANGE (CCXT) ───────────────────────────────
EXCHANGE_ID=binance             # binance | bybit | kraken | coinbase
EXCHANGE_API_KEY=your_api_key
EXCHANGE_SECRET=your_api_secret
EXCHANGE_SANDBOX=true           # true for testnet

# ── ALPACA (STOCKS) ──────────────────────────────────────
ALPACA_API_KEY=your_alpaca_key
ALPACA_SECRET_KEY=your_alpaca_secret
ALPACA_BASE_URL=https://paper-api.alpaca.markets  # paper trading

# ── AI / LLM ─────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_key
OPENAI_API_KEY=your_openai_key   # fallback
GROQ_API_KEY=your_groq_key       # console.groq.com — fastest, free tier, best for real-time signals
GEMINI_API_KEY=your_gemini_key   # aistudio.google.com — cheapest per token (Flash)
LLM_PRIMARY=claude               # claude | openai | groq | gemini | local
LLM_MODEL=claude-sonnet-4-6

# ── DATA FEEDS ───────────────────────────────────────────
NEWS_API_KEY=your_newsapi_key
ALPHA_VANTAGE_KEY=your_alphavantage_key
POLYGON_API_KEY=your_polygon_key

# ── TRAINING PIPELINE ────────────────────────────────────
FRED_API_KEY=your_fred_key              # free at https://fred.stlouisfed.org/docs/api/api_key.html
FINETUNE_BASE_MODEL=unsloth/llama-3.1-8b-bnb-4bit  # HuggingFace model for fine-tuning
DUCKDB_PATH=data/apex.db               # path to DuckDB file
OLLAMA_BASE_URL=http://localhost:11434 # local Ollama server
OLLAMA_MODEL=apex-trader               # fine-tuned model name in Ollama

# ── ECONOMIC CALENDAR ────────────────────────────────────
CALENDAR_PROVIDER=mt5            # mt5 (free, built-in) | investingcom | forexfactory | tradingecon

# ── DATABASE ─────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://apex:password@localhost:5432/apex_bot
REDIS_URL=redis://localhost:6379/0

# ── NOTIFICATIONS ────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_token
TELEGRAM_CHAT_ID=your_chat_id
SLACK_WEBHOOK_URL=your_slack_webhook
