# ═══════════════════════════════════════════════════════
#  APEX TRADING BOT — Environment Configuration
#  Copy to .env and fill in your values. NEVER commit .env
# ═══════════════════════════════════════════════════════

# ── APP ─────────────────────────────────────────────────
APP_ENV=development              # development | paper | live
APP_SECRET_KEY=change_me_to_random_string
LOG_LEVEL=INFO

# ── MT5 BROKER ──────────────────────────────────────────
MT5_LOGIN=12345678
MT5_PASSWORD=your_mt5_password
MT5_SERVER=MetaQuotes-Demo
MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe

# ── CRYPTO EXCHANGE (CCXT) ───────────────────────────────
EXCHANGE_ID=binance             # binance | bybit | kraken | coinbase
EXCHANGE_API_KEY=your_api_key
EXCHANGE_SECRET=your_api_secret
EXCHANGE_SANDBOX=true           # true for testnet

# ── ALPACA (STOCKS) ──────────────────────────────────────
ALPACA_API_KEY=your_alpaca_key
ALPACA_SECRET_KEY=your_alpaca_secret
ALPACA_BASE_URL=https://paper-api.alpaca.markets  # paper trading

# ── AI / LLM ─────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_key
OPENAI_API_KEY=your_openai_key   # fallback
LLM_PRIMARY=claude               # claude | openai | local
LLM_MODEL=claude-sonnet-4-6

# ── DATA FEEDS ───────────────────────────────────────────
NEWS_API_KEY=your_newsapi_key
ALPHA_VANTAGE_KEY=your_alphavantage_key
POLYGON_API_KEY=your_polygon_key

# ── ECONOMIC CALENDAR ────────────────────────────────────
CALENDAR_PROVIDER=investingcom   # investingcom | forexfactory | tradingecon

# ── DATABASE ─────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://apex:password@localhost:5432/apex_bot
REDIS_URL=redis://localhost:6379/0

# ── NOTIFICATIONS ────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_token
TELEGRAM_CHAT_ID=your_chat_id
SLACK_WEBHOOK_URL=your_slack_webhook
